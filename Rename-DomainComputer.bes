<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Task>
		<Title>Rename Domain-Joined Windows Computer</Title>
		<Description><![CDATA[
<P>Renames a domain-joined Windows computer using a domain account supplied at Take Action time.</P>

<P><B>How the credential is handled.</B> The BigFix agent runs as SYSTEM, which is already fully
elevated locally but authenticates on the network as <TT>DOMAIN\COMPUTER$</TT> and therefore cannot
rewrite its own Active Directory computer object. This task solves that by launching PowerShell
through <TT>override runas=localuser</TT> with <TT>asadmin=true</TT> and <TT>password=required</TT>.
The Take Action dialog prompts for the account's password and delivers it to the agent as a
<B>SecureParameter</B>. The agent consumes it directly in its process-creation call, so the password
is never written to disk, never appears on a command line, and never appears in the client logs.</P>

<P><B>Scope warning.</B> Take this action against <B>one endpoint at a time</B>. The new name is a
single action parameter, so targeting multiple computers would rename them all identically and cause
a name collision.</P>

<P><B>Requirements.</B> The supplied account needs rights on the target's AD computer object and must
not be blocked by a "Deny log on as a batch job" policy. The <TT>Secondary Logon</TT> service
(<TT>seclogon</TT>) must be able to run on the endpoint; <TT>runas=localuser</TT> depends on it, and the
action starts it if it is not already running. Domain controllers are excluded by relevance;
renaming a DC requires <TT>netdom computername</TT> instead.</P>

<P><B>Result.</B> On success the computer is flagged as requiring a restart; the rename completes on
reboot. A log is left at <TT>&lt;BES Client&gt;\__BESData\__Global\Logs\rename-computer.log</TT>.</P>

<P><B>Diagnostic action.</B> A second action, <I>RunAsLocalUser test</I>, is available from the Take
Action dialog. It performs no rename; it only exercises the same <TT>override runas=localuser</TT>
elevation used above, so you can tell whether a failure is caused by elevation itself versus the
rename logic. It logs to the same file as the main action.</P>

<P><B>Alternate action.</B> A third action, available from the Take Action dialog, renames the
computer via a nested <TT>Start-Process -Credential</TT> logon instead of BigFix's own
<TT>override runas=localuser</TT>, to test whether RPC error 1783 (<TT>RPC_X_BAD_STUB_DATA</TT>) is
specific to BigFix's token creation. It does <B>not</B> synthesize local Administrator rights the
way <TT>asadmin=true</TT> does, so the supplied account must already be a local Administrator on the
target endpoint. It logs to the same file as the main action.</P>
		]]></Description>
		<Relevance>windows of operating system</Relevance>
		<Relevance>version of client &gt;= "11.0.4"</Relevance>
		<Relevance>exists dns domainname of local computer of active directory</Relevance>
		<Relevance>exists value "PowerShellVersion" whose (it as string as version &gt;= "5.0") of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\3\PowerShellEngine" of native registry</Relevance>
		<Category>Configuration</Category>
		<Source>Internal</Source>
		<SourceID>Rename-DomainComputer</SourceID>
		<SourceReleaseDate>2026-09-01</SourceReleaseDate>
		<SourceSeverity></SourceSeverity>
		<CVENames></CVENames>
		<SANSID></SANSID>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Tue, 01 Sep 2026 00:00:00 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<DefaultAction ID="Action1">
			<Description>
				<PreLink>Click </PreLink>
				<Link>here</Link>
				<PostLink> to rename this computer.</PostLink>
			</Description>
			<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// Rename a domain-joined Windows computer.
// 2026-08-20 atlauren / Claude
//
// The password is NOT an action parameter. "password=required" on the override block
// below makes the Console prompt for it and ships it to the agent as a SecureParameter,
// so it never reaches this script, the disk, or any log.
//
// NOTE: relevance substitution runs over createfile bodies, so every literal { and }
// in the embedded PowerShell is doubled. Rename-DomainComputer.ps1 is the readable source.

action uses wow64 redirection false

action parameter query "NewComputerName" with description "New computer name (NetBIOS: max 15 characters, letters/digits/hyphen only, not all digits):"
action parameter query "AdminUser" with description "Domain account with rights to rename this computer object (DOMAIN\user or user@domain.tld):"

// Validate before touching the endpoint.
continue if {(length of it >= 1 and length of it <= 15) of (parameter "NewComputerName" of action)}
continue if {exists match (regex "^[A-Za-z0-9][A-Za-z0-9-]*$") of (parameter "NewComputerName" of action)}
continue if {not exists match (regex "^[0-9]+$") of (parameter "NewComputerName" of action)}
continue if {(parameter "AdminUser" of action) != ""}

parameter "WorkDir" = "{(value of variable "ProgramData" of environment) & "\BigFix\RenameComputer"}"
folder create "{parameter "WorkDir"}"

// The payload runs elevated, so deny non-administrators the ability to tamper with it.
waithidden "{pathname of system folder}\icacls.exe" "{parameter "WorkDir"}" /inheritance:r /grant "*S-1-5-18:(OI)(CI)F" /grant "*S-1-5-32-544:(OI)(CI)F"

delete "{parameter "WorkDir"}\Rename-DomainComputer.ps1"

createfile until _END_RENAME_PS1_
#Requires -Version 5.0
[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [string] $NewName,

    [string] $ActionId = 'manual',

    # BigFix passes the authoritative path; this default only covers manual invocation.
    [string] $LogPath = (Join-Path ([Environment]::GetFolderPath('ProgramFilesX86')) 'BigFix Enterprise\BES Client\__BESData\__Global\Logs\rename-computer.log')
)

$ErrorActionPreference = 'Stop'

function Write-Log {{
    param([string] $Message)
    $line = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss') + '  ' + $Message
    Write-Output $line
    Add-Content -LiteralPath $LogPath -Value $line -Encoding ASCII
}

try {{
    New-Item -ItemType Directory -Path (Split-Path -Parent $LogPath) -Force | Out-Null
    Write-Log ('--- BigFix action ' + $ActionId + ' started ' + (Get-Date).ToString('yyyy-MM-dd HH:mm:ss zzz') + ' ---')
    Write-Log ('Rename requested: ' + $NewName)

    $me = [Security.Principal.WindowsIdentity]::GetCurrent()
    Write-Log ('Running as: ' + $me.Name)
    $isAdmin = [Security.Principal.WindowsPrincipal]::new($me).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    Write-Log ('Elevated: ' + $isAdmin)
    if (-not $isAdmin) {{
        Write-Log 'ERROR: not running with an Administrators token.'
        exit 12
    }

    if ($NewName.Length -gt 15 -or $NewName -notmatch '^[A-Za-z0-9][A-Za-z0-9-]*$' -or $NewName -match '^[0-9]+$') {{
        Write-Log ('ERROR: invalid NetBIOS computer name: ' + $NewName)
        exit 10
    }

    if ($env:COMPUTERNAME -eq $NewName) {{
        Write-Log 'Computer already has the requested name. Nothing to do.'
        exit 0
    }

    $collision = $false
    try {{
        $searcher = [DirectoryServices.DirectorySearcher]::new()
        $searcher.Filter = '(&(objectCategory=computer)(cn=' + $NewName + '))'
        if ($null -ne $searcher.FindOne()) {{
            $collision = $true
        }
    }
    catch {{
        Write-Log ('WARNING: AD pre-flight check skipped: ' + $_.Exception.Message)
    }
    if ($collision) {{
        Write-Log ('ERROR: an AD computer object named ' + $NewName + ' already exists.')
        exit 11
    }

    Write-Log ('Renaming ' + $env:COMPUTERNAME + ' to ' + $NewName)
    $renamed = $false
    try {{
        Rename-Computer -NewName $NewName -Force -ErrorAction Stop
        $renamed = $true
        Write-Log 'Rename-Computer succeeded.'
    }
    catch {{
        # Rename-Computer may reject a null credential; the CIM method uses the caller's token.
        Write-Log ('Rename-Computer failed: ' + $_.Exception.Message)
        $result = Invoke-CimMethod -ClassName Win32_ComputerSystem -MethodName Rename -Arguments @{{ Name = $NewName }
        if ($result.ReturnValue -eq 0) {{
            $renamed = $true
            Write-Log 'Win32_ComputerSystem.Rename succeeded.'
        }
        else {{
            Write-Log ('Win32_ComputerSystem.Rename failed with return value ' + $result.ReturnValue)
        }
    }
    if (-not $renamed) {{
        exit 12
    }

    $staged = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\ComputerName\ComputerName' -Name 'ComputerName').ComputerName
    Write-Log ('Staged name in registry: ' + $staged)
    if ($staged -ne $NewName) {{
        Write-Log 'ERROR: post-rename verification failed.'
        exit 13
    }

    Write-Log 'Rename staged. Restart required to complete.'
    exit 0
}
catch {{
    Write-Log ('UNHANDLED ERROR: ' + $_.Exception.Message)
    exit 12
}
_END_RENAME_PS1_

move __createfile "{parameter "WorkDir"}\Rename-DomainComputer.ps1"

// runas=localuser depends on the Secondary Logon service; some endpoints leave it stopped.
waithidden "{pathname of system folder}\sc.exe" start seclogon

// Diagnostic: record seclogon's actual state (a disabled service fails silently above).
waithidden "{pathname of system folder}\cmd.exe" /c ""{pathname of system folder}\sc.exe" query seclogon >> "{storage folder of client}\__BESData\__Global\Logs\rename-computer.log" 2>&1"

// Only one password may be supplied per action, so there must be exactly one override block.
override wait
completion=process
hidden=true
runas=localuser
asadmin=true
user={parameter "AdminUser" of action}
password=required
wait "{pathname of system folder}\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{parameter "WorkDir"}\Rename-DomainComputer.ps1" -NewName "{parameter "NewComputerName" of action}" -ActionId "{id of action}" -LogPath "{storage folder of client}\__BESData\__Global\Logs\rename-computer.log"

continue if {exit code of action = 0}

delete "{parameter "WorkDir"}\Rename-DomainComputer.ps1"

action requires restart "This computer was renamed. A restart is required to complete the change."
			]]></ActionScript>
			<SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
		</DefaultAction>
			<Action ID="Action2">
				<Description>
					<PreLink>Click </PreLink>
					<Link>here</Link>
					<PostLink> to run a RunAsLocalUser diagnostic test (no rename is performed).</PostLink>
				</Description>
				<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// Diagnostic only: isolates whether RunAsLocalUser elevation works on this endpoint,
// independent of the rename logic in the main action. Performs no rename.
// 2026-08-31 atlauren / Claude

action uses wow64 redirection false

action parameter query "AdminUser" with description "Domain account to test RunAsLocalUser with (DOMAIN\user or user@domain.tld):"

continue if {(parameter "AdminUser" of action) != ""}

parameter "WorkDir" = "{(value of variable "ProgramData" of environment) & "\BigFix\RenameComputer"}"
folder create "{parameter "WorkDir"}"

waithidden "{pathname of system folder}\icacls.exe" "{parameter "WorkDir"}" /inheritance:r /grant "*S-1-5-18:(OI)(CI)F" /grant "*S-1-5-32-544:(OI)(CI)F"

delete "{parameter "WorkDir"}\RunAsLocalUserTest.bat"

createfile until _END_TEST_BAT_
@echo off
echo %DATE% %TIME%  [RunAsLocalUser TEST action:{id of action}] logon OK, running as %USERNAME% >> "{storage folder of client}\__BESData\__Global\Logs\rename-computer.log"
_END_TEST_BAT_

move __createfile "{parameter "WorkDir"}\RunAsLocalUserTest.bat"

// Diagnostic: record seclogon's actual state (a disabled service fails silently if started).
waithidden "{pathname of system folder}\sc.exe" start seclogon
waithidden "{pathname of system folder}\cmd.exe" /c ""{pathname of system folder}\sc.exe" query seclogon >> "{storage folder of client}\__BESData\__Global\Logs\rename-computer.log" 2>&1"

// Same override syntax as the main action, to isolate whether RunAsLocalUser itself is the problem.
override wait
completion=process
hidden=true
runas=localuser
asadmin=true
user={parameter "AdminUser" of action}
password=required
wait "{pathname of system folder}\cmd.exe" /c "{parameter "WorkDir"}\RunAsLocalUserTest.bat"

continue if {exit code of action = 0}

delete "{parameter "WorkDir"}\RunAsLocalUserTest.bat"
				]]></ActionScript>
				<SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
			</Action>
			<Action ID="Action3">
				<Description>
					<PreLink>Click </PreLink>
					<Link>here</Link>
					<PostLink> to rename this computer using the nested Start-Process -Credential diagnostic (Action 3).</PostLink>
				</Description>
				<ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// Diagnostic: renames the computer, but via a SYSTEM-launched PowerShell that itself
// spawns a second, inner PowerShell logged on as AdminUser (Start-Process -Credential),
// instead of relying on BigFix's own override runas=localuser/asadmin=true. Tests whether
// RPC error 1783 (RPC_X_BAD_STUB_DATA) is specific to BigFix's token creation.
// IMPORTANT: unlike the main action, this does NOT synthesize local Administrator rights
// (there is no PowerShell equivalent of asadmin=true) - AdminUser must already be a local
// Administrator on this endpoint and not subject to UAC filtering of that logon, or the
// inner process will fail its elevation check. See Rename-DomainComputer-Nested.ps1.
// 2026-09-01 atlauren / Claude

action uses wow64 redirection false

action parameter query "NewComputerName" with description "New computer name (NetBIOS: max 15 characters, letters/digits/hyphen only, not all digits):"
action parameter query "AdminUser" with description "Domain account with rights to rename this computer object AND local Administrator rights on this endpoint (DOMAIN\user or user@domain.tld):"
action parameter query "AdminPassword" with description "Password for that account (used once, locally, to build a PSCredential; not stored):"

// Validate before touching the endpoint.
continue if {(length of it >= 1 and length of it <= 15) of (parameter "NewComputerName" of action)}
continue if {exists match (regex "^[A-Za-z0-9][A-Za-z0-9-]*$") of (parameter "NewComputerName" of action)}
continue if {not exists match (regex "^[0-9]+$") of (parameter "NewComputerName" of action)}
continue if {(parameter "AdminUser" of action) != ""}
continue if {(parameter "AdminPassword" of action) != ""}

parameter "WorkDir" = "{(value of variable "ProgramData" of environment) & "\BigFix\RenameComputer"}"
folder create "{parameter "WorkDir"}"

// The payload runs elevated, so deny non-administrators the ability to tamper with it.
waithidden "{pathname of system folder}\icacls.exe" "{parameter "WorkDir"}" /inheritance:r /grant "*S-1-5-18:(OI)(CI)F" /grant "*S-1-5-32-544:(OI)(CI)F"

delete "{parameter "WorkDir"}\Rename-DomainComputer-Nested.ps1"

createfile until _END_RENAME_NESTED_PS1_
#Requires -Version 5.0
[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]
    [string] $NewName,

    [string] $AdminUser = '',

    # Path to a one-time file holding the domain account's password; read, then deleted.
    [string] $CredentialFile = '',

    # Set automatically when this script re-invokes itself as AdminUser; do not pass by hand.
    [switch] $Inner,

    [string] $ActionId = 'manual',

    [string] $LogPath = (Join-Path ([Environment]::GetFolderPath('ProgramFilesX86')) 'BigFix Enterprise\BES Client\__BESData\__Global\Logs\rename-computer.log')
)

$ErrorActionPreference = 'Stop'

function Write-Log {{
    param([string] $Message)
    $line = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss') + '  ' + $Message
    Write-Output $line
    Add-Content -LiteralPath $LogPath -Value $line -Encoding ASCII
}

function Get-AdminCredential {{
    param([string] $UserName, [string] $Path)
    if (-not $UserName -or -not $Path -or -not (Test-Path -LiteralPath $Path)) {{
        return $null
    }
    $secret = (Get-Content -LiteralPath $Path -Raw).TrimEnd("`r", "`n")
    $securePw = ConvertTo-SecureString -String $secret -AsPlainText -Force
    [PSCredential]::new($UserName, $securePw)
}

try {{
    New-Item -ItemType Directory -Path (Split-Path -Parent $LogPath) -Force | Out-Null

    if (-not $Inner) {{
        # --- Outer phase: runs as SYSTEM. Spawns the inner phase logged on as AdminUser. ---
        Write-Log ('--- BigFix action ' + $ActionId + ' started (outer/SYSTEM) ' + (Get-Date).ToString('yyyy-MM-dd HH:mm:ss zzz') + ' ---')
        Write-Log ('Running as: ' + [Security.Principal.WindowsIdentity]::GetCurrent().Name)

        $cred = Get-AdminCredential -UserName $AdminUser -Path $CredentialFile
        if (-not $cred) {{
            Write-Log 'ERROR: no admin credential available to launch the inner process.'
            exit 12
        }

        $self = $MyInvocation.MyCommand.Path
        $workDir = Split-Path -Parent $self
        $stdoutFile = Join-Path $workDir 'inner-stdout.log'
        $stderrFile = Join-Path $workDir 'inner-stderr.log'
        Remove-Item -LiteralPath $stdoutFile, $stderrFile -Force -ErrorAction SilentlyContinue
        $psExe = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'

        $innerArgs = @(
            '-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-File', $self,
            '-NewName', $NewName, '-AdminUser', $AdminUser, '-CredentialFile', $CredentialFile,
            '-Inner', '-ActionId', $ActionId, '-LogPath', $LogPath
        )

        $exitCode = 12
        try {{
            $proc = Start-Process -FilePath $psExe -Credential $cred -ArgumentList $innerArgs `
                -WindowStyle Hidden -Wait -PassThru `
                -RedirectStandardOutput $stdoutFile -RedirectStandardError $stderrFile
            $exitCode = $proc.ExitCode
        }
        catch {{
            Write-Log ('ERROR: could not start the inner process as ' + $AdminUser + ': ' + $_.Exception.Message)
        }
        finally {{
            $cred = $null
            Remove-Item -LiteralPath $CredentialFile -Force -ErrorAction SilentlyContinue
        }

        foreach ($f in @($stdoutFile, $stderrFile)) {{
            if (Test-Path -LiteralPath $f) {{
                Get-Content -LiteralPath $f | Where-Object {{ $_ } | ForEach-Object {{ Write-Log ('[inner] ' + $_) }
                Remove-Item -LiteralPath $f -Force -ErrorAction SilentlyContinue
            }
        }

        Write-Log ('Inner process exit code: ' + $exitCode)
        exit $exitCode
    }

    # --- Inner phase: runs as AdminUser, via Start-Process -Credential above. ---
    Write-Log ('--- BigFix action ' + $ActionId + ' started (inner/' + $AdminUser + ') ' + (Get-Date).ToString('yyyy-MM-dd HH:mm:ss zzz') + ' ---')
    Write-Log ('Rename requested: ' + $NewName)

    $me = [Security.Principal.WindowsIdentity]::GetCurrent()
    Write-Log ('Running as: ' + $me.Name)
    $isAdmin = [Security.Principal.WindowsPrincipal]::new($me).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    Write-Log ('Elevated: ' + $isAdmin)
    if (-not $isAdmin) {{
        Write-Log 'ERROR: not running with an Administrators token (see UAC note in the script header).'
        exit 12
    }

    if ($NewName.Length -gt 15 -or $NewName -notmatch '^[A-Za-z0-9][A-Za-z0-9-]*$' -or $NewName -match '^[0-9]+$') {{
        Write-Log ('ERROR: invalid NetBIOS computer name: ' + $NewName)
        exit 10
    }

    if ($env:COMPUTERNAME -eq $NewName) {{
        Write-Log 'Computer already has the requested name. Nothing to do.'
        exit 0
    }

    $cred = Get-AdminCredential -UserName $AdminUser -Path $CredentialFile
    Remove-Item -LiteralPath $CredentialFile -Force -ErrorAction SilentlyContinue

    $collision = $false
    try {{
        $searcher = [DirectoryServices.DirectorySearcher]::new()
        $searcher.Filter = '(&(objectCategory=computer)(cn=' + $NewName + '))'
        if ($null -ne $searcher.FindOne()) {{
            $collision = $true
        }
    }
    catch {{
        Write-Log ('WARNING: AD pre-flight check skipped: ' + $_.Exception.Message)
    }
    if ($collision) {{
        Write-Log ('ERROR: an AD computer object named ' + $NewName + ' already exists.')
        exit 11
    }

    Write-Log ('Renaming ' + $env:COMPUTERNAME + ' to ' + $NewName)
    $renamed = $false
    try {{
        if ($cred) {{
            Rename-Computer -NewName $NewName -DomainCredential $cred -Force -ErrorAction Stop
        }
        else {{
            Rename-Computer -NewName $NewName -Force -ErrorAction Stop
        }
        $renamed = $true
        Write-Log 'Rename-Computer succeeded.'
    }
    catch {{
        Write-Log ('Rename-Computer failed: HResult=' + $_.Exception.HResult + ' ' + $_.Exception.Message)
        $cimArgs = @{{ Name = $NewName }
        if ($cred) {{
            $cimArgs['UserName'] = $cred.UserName
            $cimArgs['Password'] = $cred.GetNetworkCredential().Password
        }
        $result = Invoke-CimMethod -ClassName Win32_ComputerSystem -MethodName Rename -Arguments $cimArgs
        if ($result.ReturnValue -eq 0) {{
            $renamed = $true
            Write-Log 'Win32_ComputerSystem.Rename succeeded.'
        }
        else {{
            Write-Log ('Win32_ComputerSystem.Rename failed with return value ' + $result.ReturnValue)
        }
    }
    finally {{
        $cred = $null
    }
    if (-not $renamed) {{
        exit 12
    }

    $staged = (Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\ComputerName\ComputerName' -Name 'ComputerName').ComputerName
    Write-Log ('Staged name in registry: ' + $staged)
    if ($staged -ne $NewName) {{
        Write-Log 'ERROR: post-rename verification failed.'
        exit 13
    }

    Write-Log 'Rename staged. Restart required to complete.'
    exit 0
}
catch {{
    Write-Log ('UNHANDLED ERROR: ' + $_.Exception.Message)
    exit 12
}
_END_RENAME_NESTED_PS1_

move __createfile "{parameter "WorkDir"}\Rename-DomainComputer-Nested.ps1"

// Written via createfile (not a shell command) so shell metacharacters in the password can't
// be interpreted; the file inherits the SYSTEM/Administrators-only ACL set above on WorkDir.
delete "{parameter "WorkDir"}\admin-nested.cred"

createfile until _END_ADMIN_NESTED_CRED_
{parameter "AdminPassword" of action}
_END_ADMIN_NESTED_CRED_

move __createfile "{parameter "WorkDir"}\admin-nested.cred"

// No override/runas is used for the outer process here; Start-Process -Credential inside
// the script does the domain-user logon itself. seclogon is still required for that.
waithidden "{pathname of system folder}\sc.exe" start seclogon

waithidden "{pathname of system folder}\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{parameter "WorkDir"}\Rename-DomainComputer-Nested.ps1" -NewName "{parameter "NewComputerName" of action}" -AdminUser "{parameter "AdminUser" of action}" -CredentialFile "{parameter "WorkDir"}\admin-nested.cred" -ActionId "{id of action}" -LogPath "{storage folder of client}\__BESData\__Global\Logs\rename-computer.log"

// Best-effort cleanup regardless of outcome; the script already deletes this itself.
delete "{parameter "WorkDir"}\admin-nested.cred"

continue if {exit code of action = 0}

delete "{parameter "WorkDir"}\Rename-DomainComputer-Nested.ps1"

action requires restart "This computer was renamed. A restart is required to complete the change."
				]]></ActionScript>
				<SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
			</Action>
	</Task>
</BES>
